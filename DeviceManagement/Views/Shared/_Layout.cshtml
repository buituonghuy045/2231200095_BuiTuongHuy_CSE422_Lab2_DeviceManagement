<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DeviceManagement</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand navbar-modern sticky-top py-2">
            <div class="container justify-content-center">
                <ul class="navbar-nav flex-row gap-2">
                    <li class="nav-item">
                        <a class="nav-pill-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-grid-1x2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-pill-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Device" ? "active" : "")"
                           asp-controller="Device" asp-action="Index">
                            <i class="bi bi-laptop"></i>
                            <span>Device</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-pill-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")"
                           asp-controller="Category" asp-action="Index">
                            <i class="bi bi-tags"></i>
                            <span>Category</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-pill-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")"
                           asp-controller="User" asp-action="Index">
                            <i class="bi bi-people"></i>
                            <span>User</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <div class="container py-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-modern alert-modern-success alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div class="flex-grow-1 fw-medium">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-modern alert-modern-danger alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div class="flex-grow-1 fw-medium">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
