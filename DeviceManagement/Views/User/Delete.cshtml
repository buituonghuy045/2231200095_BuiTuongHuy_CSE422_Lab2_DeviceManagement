@model DeviceManagement.Models.UserModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card-modern p-4 border-top border-danger border-3">
            <h5 class="fw-bold text-danger mb-3">Delete User</h5>
            <p class="text-muted small">Are you sure you want to delete this user?</p>

            <div class="p-3 bg-light rounded-3 my-3">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Full Name</span>
                    <span class="fw-bold text-dark">@Model.FullName</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Email</span>
                    <span class="text-dark small">@Model.Email</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Phone</span>
                    <span class="text-dark small">@Model.PhoneNumber</span>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted small">Assigned Devices</span>
                    <div>
                        @if (Model.Devices.Any())
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                @Model.Devices.Count device(s) will be unassigned
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                                0 devices
                            </span>
                        }
                    </div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-secondary-modern">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-danger px-4">
                        Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
