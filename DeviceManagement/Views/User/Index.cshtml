@model IEnumerable<DeviceManagement.Models.UserModel>
@{
    ViewData["Title"] = "User";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0 text-dark">User</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add User
    </a>
</div>

<div class="card-modern overflow-hidden">
    <div class="p-3 px-4 border-bottom bg-white d-flex justify-content-between align-items-center">
        <span class="fw-bold text-dark">User List</span>
        <span class="badge rounded-pill bg-light text-secondary border">@Model.Count() total</span>
    </div>

    <div class="table-responsive">
        <table class="table table-modern align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 30%;">Full Name</th>
                    <th style="width: 25%;">Email</th>
                    <th style="width: 20%;">Phone Number</th>
                    <th style="width: 10%;" class="text-center">Devices</th>
                    <th style="width: 15%;" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold text-dark">@user.FullName</span>
                            </td>
                            <td>
                                <a href="mailto:@user.Email" class="text-secondary text-decoration-none small">
                                    @user.Email
                                </a>
                            </td>
                            <td>
                                <span class="text-secondary small">@user.PhoneNumber</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@user.Id" class="badge bg-light text-primary border text-decoration-none px-2 py-1">
                                    @user.Devices.Count
                                </a>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@user.Id" 
                                       class="btn btn-sm bg-white border text-dark px-2 py-1">
                                        View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@user.Id" 
                                       class="btn btn-sm btn-primary px-2 py-1">
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@user.Id" 
                                       class="btn btn-sm btn-danger px-2 py-1">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No users found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
