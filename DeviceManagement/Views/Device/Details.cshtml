@model DeviceManagement.Models.DeviceModel
@{
    ViewData["Title"] = "Device Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-modern p-4">
            <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                <div>
                    <h4 class="fw-bold text-dark mb-1">Device Details</h4>
                    <span class="code-pill">@Model.Code</span>
                </div>
                <div>
                    @switch (Model.Status)
                    {
                        case DeviceManagement.Models.DeviceStatus.InUse:
                            <span class="status-pill status-in-use">
                                <span class="status-dot"></span> In use
                            </span>
                            break;
                        case DeviceManagement.Models.DeviceStatus.UnderMaintenance:
                            <span class="status-pill status-maintenance">
                                <span class="status-dot"></span> Under maintenance
                            </span>
                            break;
                        case DeviceManagement.Models.DeviceStatus.Broken:
                            <span class="status-pill status-broken">
                                <span class="status-dot"></span> Broken
                            </span>
                            break;
                    }
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <span class="text-muted small fw-semibold text-uppercase">Device Name</span>
                    <h5 class="fw-bold text-dark mt-1">@Model.Name</h5>
                </div>

                <div class="col-md-6">
                    <span class="text-muted small fw-semibold text-uppercase">Category</span>
                    <div class="mt-1">
                        <span class="badge rounded-pill bg-light text-dark border px-3 py-2">
                            @(Model.Category?.Name ?? "Uncategorized")
                        </span>
                    </div>
                </div>

                <div class="col-md-6">
                    <span class="text-muted small fw-semibold text-uppercase">Date of Entry</span>
                    <div class="fw-bold text-dark mt-1">@Model.DateOfEntry.ToString("yyyy-MM-dd")</div>
                </div>

                <div class="col-md-6">
                    <span class="text-muted small fw-semibold text-uppercase">Assigned User</span>
                    <div class="mt-1">
                        @if (Model.User != null)
                        {
                            <a asp-controller="User" asp-action="Details" asp-route-id="@Model.User.Id" class="fw-bold text-dark text-decoration-none">
                                <i class="bi bi-person me-1"></i>@Model.User.FullName
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small">Unassigned</span>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <a asp-action="Index" class="btn btn-secondary-modern">
                    <i class="bi bi-arrow-left me-1"></i> Back to Device List
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Code" class="btn btn-primary px-3">
                        Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Code" class="btn btn-danger px-3">
                        Delete
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
