@model IEnumerable<DeviceManagement.Models.DeviceModel>
@{
    ViewData["Title"] = "Device";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0 text-dark">Device</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Device
    </a>
</div>

<div class="card-modern p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-lg-5 col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="searchTerm" value="@ViewBag.CurrentSearch"
                       class="form-control border-start-0 ps-0" placeholder="Search by name or device code..." />
            </div>
        </div>

        <div class="col-lg-3 col-md-3">
            <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                <option value="">All Categories</option>
            </select>
        </div>

        <div class="col-lg-2 col-md-3">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<DeviceManagement.Models.DeviceStatus>())
                {
                    var isSelected = ViewBag.CurrentStatus != null && (DeviceManagement.Models.DeviceStatus)ViewBag.CurrentStatus == s;
                    <option value="@s" selected="@isSelected">@s</option>
                }
            </select>
        </div>

        <div class="col-lg-2 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
                Filter
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || !string.IsNullOrEmpty(ViewBag.CurrentCategory) || ViewBag.CurrentStatus != null)
            {
                <a asp-action="Index" class="btn btn-secondary-modern" title="Reset">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </form>
</div>

<div class="card-modern overflow-hidden">
    <div class="p-3 px-4 border-bottom bg-white d-flex justify-content-between align-items-center">
        <span class="fw-bold text-dark">Device List</span>
        <span class="badge rounded-pill bg-light text-secondary border">@Model.Count() total</span>
    </div>

    <div class="table-responsive">
        <table class="table table-modern align-middle mb-0">
            <thead>
                <tr>
                    <th>Device Code</th>
                    <th>Device Name</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Date of Entry</th>
                    <th>Assigned User</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="code-pill">@item.Code</span></td>
                            <td class="fw-bold text-dark">@item.Name</td>
                            <td>
                                <span class="badge rounded-pill bg-light text-secondary border">
                                    @(item.Category?.Name ?? "Uncategorized")
                                </span>
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case DeviceManagement.Models.DeviceStatus.InUse:
                                        <span class="status-pill status-in-use">
                                            <span class="status-dot"></span> In use
                                        </span>
                                        break;
                                    case DeviceManagement.Models.DeviceStatus.UnderMaintenance:
                                        <span class="status-pill status-maintenance">
                                            <span class="status-dot"></span> Under maintenance
                                        </span>
                                        break;
                                    case DeviceManagement.Models.DeviceStatus.Broken:
                                        <span class="status-pill status-broken">
                                            <span class="status-dot"></span> Broken
                                        </span>
                                        break;
                                }
                            </td>
                            <td>
                                <span class="text-secondary small">@item.DateOfEntry.ToString("yyyy-MM-dd")</span>
                            </td>
                            <td>
                                @if (item.User != null)
                                {
                                    <a asp-controller="User" asp-action="Details" asp-route-id="@item.User.Id" class="text-dark text-decoration-none small">
                                        <i class="bi bi-person me-1"></i>@item.User.FullName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Unassigned</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Code" 
                                       class="btn btn-sm bg-white border text-dark px-2 py-1">
                                        View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Code" 
                                       class="btn btn-sm btn-primary px-2 py-1">
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Code" 
                                       class="btn btn-sm btn-danger px-2 py-1">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No devices found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
