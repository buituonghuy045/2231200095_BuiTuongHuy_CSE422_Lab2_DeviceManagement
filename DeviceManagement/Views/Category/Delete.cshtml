@model DeviceManagement.Models.CategoryModel
@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card-modern p-4 border-top border-danger border-3">
            <h5 class="fw-bold text-danger mb-3">Delete Category</h5>
            <p class="text-muted small">Are you sure you want to delete this category?</p>

            <div class="p-3 bg-light rounded-3 my-3">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Category Name</span>
                    <span class="fw-bold text-dark">@Model.Name</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Description</span>
                    <span class="text-dark small">@(string.IsNullOrWhiteSpace(Model.Description) ? "None" : Model.Description)</span>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted small">Devices</span>
                    <div>
                        @if (Model.Devices.Any())
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                @Model.Devices.Count device(s)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                0 devices
                            </span>
                        }
                    </div>
                </div>
            </div>

            @if (Model.Devices.Any())
            {
                <div class="alert alert-modern alert-modern-danger mb-4">
                    <div class="small">
                        Cannot delete category while @Model.Devices.Count device(s) are attached.
                    </div>
                </div>
            }

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-secondary-modern">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-danger px-4" @(Model.Devices.Any() ? "disabled" : "")>
                        Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
