@model DeviceManagement.Models.CategoryModel
@{
    ViewData["Title"] = "Create Category";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card-modern p-4">
            <h4 class="fw-bold text-dark mb-4 pb-2 border-bottom">Create Category</h4>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-modern alert-modern-danger mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-bold text-secondary"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Computer, Printer, Phone..." autofocus />
                    <span asp-validation-for="Name" class="text-danger small d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label small fw-bold text-secondary"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small d-block"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-secondary-modern">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        Save Category
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
