@model IEnumerable<DeviceManagement.Models.CategoryModel>
@{
    ViewData["Title"] = "Category";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0 text-dark">Category</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Category
    </a>
</div>

<div class="card-modern overflow-hidden">
    <div class="p-3 px-4 border-bottom bg-white d-flex justify-content-between align-items-center">
        <span class="fw-bold text-dark">Category List</span>
        <span class="badge rounded-pill bg-light text-secondary border">@Model.Count() total</span>
    </div>

    <div class="table-responsive">
        <table class="table table-modern align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 25%;">Category Name</th>
                    <th style="width: 40%;">Description</th>
                    <th style="width: 15%;" class="text-center">Devices</th>
                    <th style="width: 20%;" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold text-dark">@item.Name</span>
                            </td>
                            <td>
                                <span class="text-secondary small">@(string.IsNullOrWhiteSpace(item.Description) ? "None" : item.Description)</span>
                            </td>
                            <td class="text-center">
                                <a asp-controller="Device" asp-action="Index" asp-route-categoryId="@item.Id"
                                   class="badge bg-light text-primary border text-decoration-none px-2 py-1"
                                   title="Filter devices by this category">
                                    @item.Devices.Count device(s)
                                </a>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-controller="Device" asp-action="Index" asp-route-categoryId="@item.Id" 
                                       class="btn btn-sm bg-white border text-dark px-2 py-1" title="View Devices">
                                        View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" 
                                       class="btn btn-sm btn-primary px-2 py-1">
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" 
                                       class="btn btn-sm btn-danger px-2 py-1">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No categories found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
